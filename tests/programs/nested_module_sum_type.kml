module A = mod
    module B = mod
        typedef t = | Some {contents : int} | None {}

        val mk = fun (n : int) -> Some {contents : n}

        val get = fun (o : t) ->
            match o with
            | Some {contents : x} -> x
            | None {} -> 0
    end

    val y = B.get (B.mk 7)
end

val run = fun () -> A.y
